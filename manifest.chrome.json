{
    "manifest_version": 3,
    "name": "SoundDLib",
    "version": "0.0.1",
    "description": "Скачивает треки и плейлисты со Звука в выбранном аудиоформате.",
    "author": "https://ivanvit.ru",
    "homepage_url": "https://github.com/ivanvit100/SoundDLib",

    "background": {
        "service_worker": "background/service-worker.js"
    },

    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },

    "permissions": [
        "activeTab",
        "tabs",
        "downloads",
        "storage",
        "webRequest",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "scripting"
    ],

    "host_permissions": [
        "https://zvuk.com/*",
        "https://*.zvuk.com/*",
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.ua/*",
        "https://storage.mds.yandex.net/*",
        "https://strm.yandex.ru/*"
    ],

    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },

    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },

    "content_scripts": [],

    "web_accessible_resources": [
        {
            "resources": ["lib/ffmpeg-core.js", "lib/ffmpeg-core.wasm", "lib/ffmpeg-core.worker.js", "services/zvuk/ZvukInterceptor.js"],
            "matches": ["https://zvuk.com/*", "https://*.zvuk.com/*"]
        },
        {
            "resources": ["lib/ffmpeg-core.js", "lib/ffmpeg-core.wasm", "lib/ffmpeg-core.worker.js"],
            "matches": [
                "https://music.yandex.ru/*",
                "https://music.yandex.com/*",
                "https://music.yandex.by/*",
                "https://music.yandex.kz/*",
                "https://music.yandex.ua/*"
            ]
        }
    ]
}
